# TRUSTCHAIN AUDIT ENVIRONMENT VARIABLES

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (PostgreSQL for cloud; local JSON database fallback enabled by default)
DATABASE_URL=postgresql://trustchain:trustchain_pass@localhost:5432/trustchain_db

# EVM Blockchain Network Configuration
# Default: Base Mainnet (Coinbase L2)
EVM_CHAIN_ID=8453
EVM_RPC_URL=https://mainnet.base.org
EVM_REGISTRY_CONTRACT=0x71C8354366A96C2522778B27bF13fF1A3d596495
EVM_SIGNER_PRIVATE_KEY=

# Storage Backend (Options: encrypted_vault, aws_s3, cloudflare_r2, ipfs)
STORAGE_PROVIDER=encrypted_vault
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=trustchain-evidence-vault

# AI Assistant Engine (Provider-Independent: Heuristic rule-engine is active by default; external API keys optional)
OPENAI_API_KEY=
GEMINI_API_KEY=

